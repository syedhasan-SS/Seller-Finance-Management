# Supabase Configuration
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key-here

# SendBird Platform API (server-side, used by scripts/sendbird-broadcast.mjs)
# App ID and Platform API token from the SendBird dashboard. NEVER expose these client-side.
SENDBIRD_APP_ID=your-sendbird-application-id
SENDBIRD_API_TOKEN=your-platform-api-token
SENDBIRD_SENDER_ID=fleek-bot-user-id   # SendBird user_id the messages appear from
# SENDBIRD_API_BASE=https://api-your-app-id.sendbird.com  # optional override
